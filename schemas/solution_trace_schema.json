{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolutionTrace",
  "type": "object",
  "required": [
    "item_id",
    "steps"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "expr",
          "operation"
        ],
        "properties": {
          "step_id": {
            "type": "integer"
          },
          "expr": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "result": {
            "type": [
              "string",
              "null"
            ]
          },
          "premises": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "verification": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  }
}